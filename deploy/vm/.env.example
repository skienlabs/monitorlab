# Copy to ~/docker/apps/monitorlab/.env and fill in.

# Image pushed by GitHub Actions. Pin a commit tag (e.g. :a1b2c3d) to roll back.
MONITORLAB_IMAGE=us-central1-docker.pkg.dev/YOUR_GCP_PROJECT_ID/test-images/monitorlab:latest

# Address agents and alert links use to reach the hub.
MONITORLAB_PUBLIC_URL=https://monitor.skienlab.com:8443
# Names / IPs for the auto-generated TLS certificate (comma separated).
MONITORLAB_TLS_SANS=monitor.skienlab.com

# First start only: initial administrator. Leave the password empty to get a
# generated one in `docker logs monitorlab` (you must change it at first sign-in).
MONITORLAB_ADMIN_EMAIL=admin@skienlab.com
# MONITORLAB_ADMIN_PASSWORD=

TZ=Asia/Kolkata

# --- Behind Nginx Proxy Manager instead (TLS terminated by NPM) ---------------
# MONITORLAB_TLS=off
# Do NOT open port 8090 in the GCP firewall; only NPM should reach it.
# MONITORLAB_LISTEN=0.0.0.0:8090
# MONITORLAB_TRUST_PROXY=true
# MONITORLAB_SECURE_COOKIES=true
# MONITORLAB_PUBLIC_URL=https://monitor.skienlab.com
# In NPM: forward http to 172.17.0.1:8090 (the Docker bridge gateway) and enable
# "Websockets Support". Agents then use https://monitor.skienlab.com with no fingerprint.
